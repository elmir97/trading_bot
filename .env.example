# ============================================================
# Скопировать в .env и заполнить. Файл .env в git не попадает.
# ============================================================

# --- Окружение ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую.
# Пустое значение = бот отвечает всем. Для персонального бота заполнить обязательно.
ALLOWED_TELEGRAM_IDS=

DEFAULT_TIMEZONE=Asia/Yekaterinburg

# --- PostgreSQL ---
# Внутри docker-compose хост = postgres. Локально = localhost.
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME@postgres:5432/trading_bot
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trading_bot
DB_ECHO=false

# --- Шифрование биржевых ключей ---
# Сгенерировать: python -m scripts.generate_key
ENCRYPTION_KEY=

# --- BingX (этап 7; ключи ТОЛЬКО read-only, привязанные к IP сервера) ---
BINGX_BASE_URL=https://open-api.bingx.com

# --- BingX: два счёта, реальный и демо (этап 15.4в) ---
# Ключи больше НЕ хранятся в .env — заводятся в боте, «Настройки → Ключи
# BingX», отдельная пара на каждый режим. Хосты ниже проверены по живому
# API (GET .../openApi/swap/v2/quote/contracts), не по статьям:
BINGX_LIVE_BASE_URL=https://open-api.bingx.com
BINGX_DEMO_BASE_URL=https://open-api-vst.bingx.com

# --- BingX: исполнение сделок (этап 15) ---
# Ключ ТЕПЕРЬ должен иметь право Perpetual Futures Trading (Withdraw и
# Universal Transfer — выключены), привязан к IP 147.45.111.10.
# Куда РЕАЛЬНО уходят ордера — demo (VST) или live. Это НЕ переключатель
# показа в настройках бота (UserSettings.active_exchange_mode) — если они
# разойдутся, guard MODE_NOT_ALLOWED заблокирует вход. Переключение
# режима исполнения — только через .env + рестарт, кнопки в боте нет.
BINGX_TRADING_MODE=demo

# --- Дефолты торгового плана ---
DEFAULT_RISK_PER_TRADE_PERCENT=2.0
DEFAULT_MAX_DAILY_LOSS_PERCENT=6.0
DEFAULT_MAX_WEEKLY_LOSS_PERCENT=10.0
DEFAULT_MAX_TRADES_PER_DAY=5
MIN_RISK_REWARD=2.0

# --- Импорт истории сделок ---
IMPORT_HISTORY_DAYS=365
IMPORT_POLL_INTERVAL_SECONDS=300

# --- Прокси для Telegram ---
# Заполнять ТОЛЬКО если хостинг блокирует IP Telegram (симптом: бот
# перезапускается по кругу с TelegramNetworkError: Request timeout).
# Формат: socks5://user:pass@host:port  или  http://user:pass@host:port
TELEGRAM_PROXY=

# --- AI-слой (этап 11): разбор журнала ---
# Через ProxyAPI (api.proxyapi.ru) — держит нативный Anthropic Messages API.
# Ключ добавляется в /opt/trading_bot/.env на сервере вручную; стандартная
# команда деплоя .env не трогает.
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_INPUT_TOKENS=20000
AI_BASE_URL=https://api.proxyapi.ru/anthropic
AI_AUTH_SCHEME=x-api-key
AI_PRICING_PROFILE=proxyapi
# ВАЖНО: при AI_PRICING_PROFILE=proxyapi бюджет считается в РУБЛЯХ, хотя
# имя переменной осталось "_USD". 500 при Sonnet — примерно 75 разборов.
AI_MONTHLY_BUDGET_USD=500
# Если ProxyAPI ответит 401 на x-api-key — переключить AI_AUTH_SCHEME=bearer.

# --- Фоновые задачи (этап 12): сканер сетапов, монитор позиций, уведомления ---
# Держать false, пока этап не обкатан и не подтверждён — включает сразу все
# три задачи разом, отдельного выключателя на каждую нет.
BACKGROUND_JOBS_ENABLED=false

SETUP_SCANNER_INTERVAL_MINUTES=30
# Он же порог повторного уведомления по тому же сетапу, если условия не
# изменились ("время жизни" строки в таблице signals).
SETUP_SCANNER_TTL_HOURS=4

POSITION_MONITOR_INTERVAL_MINUTES=5
# Последние N% пути от входа до TP/SL считаются "приближением".
POSITION_MONITOR_APPROACH_PERCENT=10

DAILY_JOBS_INTERVAL_MINUTES=15
# Час по местному времени пользователя, после которого шлётся дневная сводка.
DAILY_SUMMARY_HOUR_LOCAL=20

# --- Redis (этап 15: блокировка от двойного нажатия «Да», раздел 8) ---
REDIS_URL=redis://localhost:6379/0

# --- Исполнение сделок по подтверждению (этап 15, раздел 11 ТЗ) ---
# Главный выключатель. По умолчанию выключено — переключатель в настройках
# бота может только выключить исполнение дополнительно, включить при
# TRADING_EXECUTION_ENABLED=false он не может.
TRADING_EXECUTION_ENABLED=false
EXEC_MAX_OPEN_POSITIONS=4
EXEC_MAX_TOTAL_RISK_PERCENT=5
# Доля расстояния до стопа — допустимый дрейф цены при подтверждении.
EXEC_MAX_PRICE_DRIFT_RATIO=0.3
EXEC_CONFIRM_TTL_SECONDS=60
# Как часто перепроверять права ключа BingX (apiRestrictions) при
# построении карточки подтверждения.
EXEC_PERMISSIONS_TTL_HOURS=6
EXEC_MIN_RR=1.5
EXEC_SYMBOL_WHITELIST=BTC-USDT,ETH-USDT
# Час по местному времени пользователя для ежедневной сводки исполнения.
EXEC_DAILY_DIGEST_HOUR=21
